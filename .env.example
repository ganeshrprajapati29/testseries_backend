# ---------- Core ----------
NODE_ENV=development
PORT=5000
# Public URL of the student/admin web app (used in emails and CORS)
APP_URL=http://localhost:5173
# Comma separated list of trusted browser origins
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind Nginx / a single reverse proxy
TRUST_PROXY=0

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/civil_sansad
# Used only by the automated test-suite (the database is wiped between tests)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/civil_sansad_test

# ---------- Sessions & cookies ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=12
# Leave empty for host-only cookies (recommended). Example: .civilsansad.com
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ---------- Email (password reset) ----------
# When SMTP_HOST is empty in development, reset links are written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Civil Sansad <no-reply@civilsansad.com>"

# ---------- File storage ----------
# local | s3   (use s3 / S3-compatible storage when running multiple or ephemeral servers)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
# Private files (question paper PDFs) - streamed only after an access check, never served by nginx
PRIVATE_UPLOAD_DIR=storage/private
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------- Payments (optional, Razorpay) ----------
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Redis (optional cache + shared rate limits) ----------
# Leave empty to run without Redis. Example: redis://:password@127.0.0.1:6379/0
REDIS_URL=
REDIS_PREFIX=cs:

# English -> Hindi auto translation (admin editors and imports)
#   google-free (default, no key) | google (Cloud Translation v2, needs TRANSLATE_API_KEY) | libre (LibreTranslate at TRANSLATE_API_URL) | none
TRANSLATE_PROVIDER=google-free
TRANSLATE_API_KEY=
TRANSLATE_API_URL=
